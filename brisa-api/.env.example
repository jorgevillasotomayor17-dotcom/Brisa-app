# Copia este archivo como ".env" y completa los valores. El ".env" NO se sube a GitHub.

# Cadena de Atlas con tu usuario y contraseña reales
MONGODB_URI=mongodb+srv://Brisa:TU_CONTRASENA@cluster0.834dwyw.mongodb.net/

# Nombre de la base de datos (se crea sola al guardar el primer dato)
