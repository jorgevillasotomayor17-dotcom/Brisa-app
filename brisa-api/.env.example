# Clave para las acciones del administrador (inventa una larga)
ADMIN_KEY=cambia-esto-por-una-clave-larga

# Páginas que pueden llamar a la API, separadas por coma (solo el origen, sin ruta)
ALLOWED_ORIGINS=https://TU_USUARIO.github.io,http://127.0.0.1:5500
